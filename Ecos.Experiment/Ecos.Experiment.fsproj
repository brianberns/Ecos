<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Scenario.fs" />
    <Compile Include="Experiment1.fs" />
    <Compile Include="Experiment2.fs" />
    <Compile Include="Experiment3.fs" />
    <Compile Include="Experiment4.fs" />
    <Compile Include="Experiment8.fs" />
    <Compile Include="Experiment15.fs" />
    <Compile Include="Experiment26.fs" />
    <Compile Include="ProposedPhysics.fs" />
    <Compile Include="Checks.fs" />
    <Compile Include="Registry.fs" />
    <Compile Include="ScenarioSpec.fs" />
    <Compile Include="Experiment27.fs" />
    <Compile Include="Experiment28.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ecos\Ecos.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
  </ItemGroup>

</Project>
