<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ServerGarbageCollector>true</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Scenario.fs" />
    <Compile Include="Experiment1.fs" />
    <Compile Include="Experiment2.fs" />
    <Compile Include="Experiment3.fs" />
    <Compile Include="Experiment4.fs" />
    <Compile Include="Experiment8.fs" />
    <Compile Include="Experiment11.fs" />
    <Compile Include="Registry.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ecos\Ecos.fsproj" />
  </ItemGroup>

</Project>
